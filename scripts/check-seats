#!/usr/bin/env bash
# ============================================================
# check-seats — inspect box Chrome seats and enforce fail-closed invariants
#
# Usage:
#   ./scripts/check-seats [--json] [--no-probe]
#   ./scripts/check-seats --check-action=kill-chrome
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_BIN="${AGENTCHAT_NODE:-node}"

if ! command -v "${NODE_BIN}" >/dev/null 2>&1; then
    echo "[ERROR] node not found on PATH (AGENTCHAT_NODE can override)." >&2
    exit 1
fi

exec "${NODE_BIN}" "${SCRIPT_DIR}/lib/seat-census.cjs" "$@"
