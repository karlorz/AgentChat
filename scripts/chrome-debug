#!/usr/bin/env bash
# ============================================================
# chrome-debug — extensionless helper entry point (POSIX + Git Bash)
#
# The canonical Chrome CDP lifecycle command. Contains no policy:
# it resolves its own directory and execs the shared Node lifecycle
# engine (scripts/lib/chrome-debug-lifecycle.cjs) with the original
# arguments, so every platform runs the exact same engine.
#
# Invoke via scripts/run-helper.cmd chrome-debug ... on Windows
# (which locates Git Bash and runs this file) or directly on POSIX.
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

NODE_BIN="${AGENTCHAT_NODE:-node}"
if ! command -v "${NODE_BIN}" >/dev/null 2>&1; then
    echo "[ERROR] node not found on PATH (AGENTCHAT_NODE can override)." >&2
    exit 1
fi

exec "${NODE_BIN}" "${SCRIPT_DIR}/lib/chrome-debug-lifecycle.cjs" "$@"
