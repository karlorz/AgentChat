# AgentChat — 环境配置文件
# 复制为 .env 并根据你的环境修改:
#   cp .env.example .env
#
# 脚本会自动加载项目根目录的 .env 文件，无需手动 source。

# 本文件自 v16 起由 Node 侧 (skills/lib/cdp.js) 直接安全加载 — 不再依赖
# shell wrapper source。v31 起的查找顺序（命中即停）:
#   1. $AGENTCHAT_ENV_FILE
#   2. $AGENTCHAT_HOME/.env
#   3. $HOME/.agentchat/.env      ← 跨部署/跨工程推荐
#   4. 入口脚本向上爬的祖先目录里的 .env（≤12 级）
#   5. <__dirname>/../../.env      (legacy, 仓库根)
#   6. <process.cwd()>/.env        (legacy, 调用方工程)
# 完整文档见 skills/AgentChat-OneWeb/SKILL.md 的「配置加载」段。
# 已存在的进程环境变量优先于本文件。值永远按字面字符串处理，绝不执行。

# Chrome/Chromium 二进制路径 (REQUIRED — 必须设置为系统 Chrome，不能用 Playwright 自带)
# Linux 常见路径: /usr/bin/google-chrome-stable, /usr/bin/chromium
# macOS 常见路径: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Windows 常见路径: C:\Program Files\Google\Chrome\Application\chrome.exe
# 未设置时 v16 内嵌启动器按上述标准路径自动探测（含 Edge 兜底）。
CHROMIUM_PATH=

# AgentChat CDP 调试端口。AgentChat 默认保留 9222；不要把 Fork-5 的 9227
# 当作 AgentChat 默认值。Box Fork-N 席位遵循 DISPLAY :N → CDP 9222+N。
CDP_PORT=9222

# CDP 主机 (默认 127.0.0.1)。仅在 Chrome 与 skill 不在同一网络命名空间时设置：
# 典型场景 = WSL2 里跑 skill、Chrome 跑在 Windows 宿主 —— WSL2 内的
# 127.0.0.1 指向 VM 自身，需改为 Windows 宿主 IP（cat /etc/resolv.conf 的
# nameserver 行），且 Windows 侧 Chrome 需加 --remote-debugging-address=0.0.0.0
# （仅限可信网络！该端口等于整个已登录 profile 的完全控制权）。
# CDP_HOST=127.0.0.1

# HTTP/SOCKS5 代理地址 (中国大陆用户必须配置)
PROXY_SERVER=http://127.0.0.1:7897

# Chrome 持久化 Profile 目录 (保存 Google 登录状态)。Box Fork-N 席位使用
# /home/box/chrome-profile/Fork-N；AgentChat 默认不借用任何 Fork-N profile。
# Windows 用户: `~` 由 start-chrome.ps1 (v15+) 展开为 %USERPROFILE%；
# 旧版脚本会把字面 `~` 传给 Chrome 导致登录态写入错误目录。
# 建议 Windows 上直接写绝对路径，如 C:\Users\<you>\.chrome-debug-profile
CHROME_PROFILE=~/.chrome-debug-profile

# Gemini URL
GEMINI_URL=https://gemini.google.com/u/0/app

# 日志文件
LOG_FILE=/tmp/chrome-debug.log

# 无头模式 (默认: false, 即 GUI 可见窗口)
# 设置为 "1" / "true" / "yes" 启用 headless
HEADLESS=false

# Gemini 模型选择 (2026-10-14+):
#   argon      = 默认；必须选中并验证菜单内最新 Argon（非 Flash/Lite/Pro/Ultra/Spark）及高推理
#   (unset / legacy flash 也走 argon，避免 ~/.agentchat/.env 的 flash 继续强迫 Flash+延伸思考)
#   pro        = Pro Extended Thinking，需订阅；不可用时仅回退至已验证的 newest Argon + 高推理
#   full-flash = 显式 opt-in；菜单内最新完整 Flash + 高推理（若菜单仍有完整 Flash）
#AGENTCHAT_GEMINI_MODEL=argon

# Gemini composer chips under the input (2026-10-15+):
#   task = default; 任務 / Task — custom MCP / @ connectors bind here
#   chat = opt-in; 對話 / Chat — connectors do not bind
# Top-level @ chips are connectors (WebCodex Local Projects, SkillWiki).
# GrokSearch and trends are inner projects/servers inside WebCodex, not extra @ chips.
# Task mode also inserts `@Webcodex Local Projects` after the composer clear
# (same pattern as ChatGPT @Web search). Set 1 to skip the mention.
#AGENTCHAT_GEMINI_COMPOSER_MODE=task
#AGENTCHAT_GEMINI_NO_MCP_MENTION=0

# Quota-safe ChatGPT timeout recovery (disabled by default).
# When set to 1, a proven ChatGPT submission gets one additional observation
# budget on the same conversation. If it is still generating, AgentChat returns
# submitted_pending with safe_to_resend=false and stops fallback instead of
# submitting the prompt again. Recommended user override: ~/.agentchat/.env.
AGENTCHAT_CHATGPT_RESUME_ON_TIMEOUT=0

# Muse chat target. Default is a new session (https://muse.ai/thread/new).
# Set `main` (or https://muse.ai/) for Main chat, or a
# https://muse.ai/thread/<uuid> URL to reuse an existing thread. CLI
# --resume-muse= wins over this value. A standing Muse tab on a different
# path is left alone; OneWeb opens a new tab for the requested target.
#AGENTCHAT_MUSE_URL=new
